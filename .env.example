# Copy to backend/.env (run uvicorn from backend/). Never commit real keys.
# LLM
# mock = luật từ khóa cho kịch bản test, KHÔNG hiểu tin nhắn tự do (có thể bỏ sót). Các lớp tất định
# (QR, SIMO/GNN, URL, PII, policy) vẫn chạy. Để dùng LLM thật: LLM_PROVIDER=anthropic + khóa + model, rồi khởi động lại uvicorn.
LLM_PROVIDER=mock                 # mock | anthropic | openai_compat | bedrock
ANTHROPIC_API_KEY=                # bắt buộc khi LLM_PROVIDER=anthropic (sk-ant-...)
# Nên dùng model nhanh (vd claude-haiku-4-5) vì LLM_TIMEOUT_MS cắt sau 4 giây; model phải nằm trong quyền của khóa API.
ANTHROPIC_MODEL=claude-sonnet-4-5
# --- openai_compat: mọi API tương thích OpenAI Chat Completions (cần cả 3 biến, thiếu thì backend không khởi động) ---
# OPENAI_COMPAT_BASE_URL=https://opencode.ai/inference/openai/v1
# OPENAI_COMPAT_API_KEY=            # điền khóa của bạn, KHÔNG commit
# OPENAI_COMPAT_MODEL=              # model trả phí/có credit; model "-free" của OpenCode chỉ chạy trong app OpenCode
# OPENAI_COMPAT_JSON_MODE=json_schema   # json_schema | tools | json_object (đổi nếu nhà cung cấp không hỗ trợ)
# Ví dụ khác:
#   Gemini  : OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  (model Flash/Flash-Lite)
#   DeepSeek: OPENAI_COMPAT_BASE_URL=https://api.deepseek.com  (thường dùng json_object)
LLM_TIMEOUT_MS=4000
MOCK_LLM_DELAY_MS=0
# Bảo mật / phiên
SESSION_HASH_SECRET=change-me-local-only
GUARDIAN_DEBUG=false              # bật override debug, /api/debug/*, kịch bản T22/T29
# Dữ liệu
FIXTURES_DIR=../fixtures
SANDBOX_NOW=2026-11-30T20:00:00+07:00
AUDIT_LOG_PATH=./var/audit.jsonl
RISK_MEMORY_TTL_HOURS=24
# Ngưỡng
FAN_IN_VELOCITY_THRESHOLD=10
PREFILTER_SOFT_THRESHOLD=0.85
# Tích hợp tùy chọn
GOOGLE_SAFE_BROWSING_API_KEY=
MOMO_HOTLINE=1900545441           # team xác minh lại số trước khi demo
CORS_ORIGINS=
# Web: cấu hình riêng trong web/.env.example (VITE_API_BASE_URL=/api)
